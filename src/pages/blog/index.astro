---
import { getCollection } from 'astro:content';
import Layout  from '../../layouts/Layout.astro';
import Header  from '../../components/Header.astro';
import Footer  from '../../components/Footer.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories: Record<string, string> = {
  'control-de-peso':      'Control de peso',
  'medicina-del-deporte': 'Medicina del Deporte',
  'prevencion':           'Prevención y Rehabilitación',
  'ciencia-aplicada':     'Ciencia Aplicada',
};
---

<Layout
  title="Blog | Dr. Alan Polanco — Medicina del Deporte"
  description="Artículos sobre ejercicio, medicina del deporte y salud por el Dr. Alan Polanco. Ciencia aplicada, explicada."
>
  <Header />
  <main class="pt-16 md:pt-20">

    <!-- Page header -->
    <div class="bg-warm py-14 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Conocimiento aplicado</p>
        <h1 class="font-display text-4xl md:text-5xl text-dark mb-4">Blog</h1>
        <p class="text-muted text-base md:text-lg max-w-xl leading-relaxed">
          Ciencia del deporte, ejercicio y salud — explicados para que puedas tomar mejores decisiones.
        </p>
      </div>
    </div>

    <!-- Article grid -->
    <div class="bg-surface py-14 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        {posts.length === 0 && (
          <p class="text-center text-muted py-20">Próximos artículos en camino.</p>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => {
            const slug = post.id.replace(/\.(md|mdx)$/, '');
            return (
              <article class="group bg-warm rounded-2xl overflow-hidden border border-gray-100 hover:border-primary/20 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">

                {post.data.image ? (
                  <div class="aspect-video overflow-hidden">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt ?? post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                ) : (
                  <div class="aspect-video bg-gradient-to-br from-primary/12 to-accent/12 flex items-center justify-center">
                    <svg class="w-10 h-10 text-primary/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                )}

                <div class="p-6 flex flex-col flex-1">
                  <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
                    <span class="text-xs font-semibold text-primary bg-primary/10 px-2.5 py-1 rounded-full">
                      {categories[post.data.category] ?? post.data.category}
                    </span>
                    <span class="text-xs text-muted">
                      {post.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                  </div>

                  <h2 class="font-semibold text-dark text-sm leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-2">
                    {post.data.title}
                  </h2>

                  <p class="text-xs text-muted leading-relaxed flex-1 mb-5 line-clamp-3">
                    {post.data.description}
                  </p>

                  <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
                    {post.data.readingTime && (
                      <span class="text-xs text-muted">{post.data.readingTime} min de lectura</span>
                    )}
                    <a
                      href={`/blog/${slug}`}
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:gap-2.5 transition-all duration-200 ml-auto"
                    >
                      Leer más
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

      </div>
    </div>
  </main>
  <Footer />
</Layout>
