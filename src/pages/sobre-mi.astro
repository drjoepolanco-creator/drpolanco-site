---
import Layout      from '../layouts/Layout.astro';
import Header      from '../components/Header.astro';
import Footer      from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const WA = "https://wa.me/525644237028?text=Hola%20Dr.%20Polanco%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta.";

const credenciales = [
  { inst: 'UNAM',                                desc: 'Médico Cirujano · Cédula Profesional 6382840' },
  { inst: 'IPN',                                 desc: 'Especialidad en Medicina del Deporte · Cédula Profesional 10861477' },
  { inst: 'FIFA',                                desc: 'Diploma in Football Medicine' },
  { inst: 'CoNaMeDe',                            desc: 'Certificación vigente' },
  { inst: 'QP Clinic',                           desc: 'Director General' },
  { inst: 'Hospital General Dr. Rubén Leñero',   desc: 'Médico adscrito' },
  { inst: 'Equipo Pumas UNAM',                   desc: 'Médico del Deporte · 2015 - 2018' },
  { inst: 'Escuela de Medicina St. Luke',        desc: 'Profesor' },
];

const historia = [
  {
    titulo: 'El punto de partida',
    texto: 'Elegí la Medicina del Deporte porque entendí algo que la medicina tradicional suele ignorar: el cuerpo humano está diseñado para moverse. Cada paciente que llega a mi consultorio lleva consigo una historia — un deportista que creyó que su lesión era el fin, un adulto que perdió su salud junto con su rutina, alguien que simplemente quiere entender por qué su cuerpo ya no responde como antes.',
  },
  {
    titulo: 'La formación',
    texto: 'Me formé en la UNAM y en el IPN porque quería la base científica más sólida posible. Fui médico del equipo Pumas porque quería aprender bajo presión real. Hoy dirijo QP Clinic y trabajo en el Hospital General Dr. Rubén Leñero porque creo que la medicina del deporte no es solo para atletas de élite — es para cualquier persona que quiera vivir mejor, moverse sin dolor y envejecer con dignidad.',
  },
  {
    titulo: 'La filosofía',
    texto: 'No lo considero un trabajo. Es una forma de vida.',
    cita: true,
  },
];
---

<Layout
  title="Sobre el Dr. Alan Polanco | Medicina del Deporte CDMX"
  description="Conoce la historia y formación del Dr. José Alan Polanco Fierro, especialista en Medicina del Deporte egresado de la UNAM e IPN, Director de QP Clinic y médico adscrito al Hospital General Dr. Rubén Leñero."
>
  <Header />

  <main>

    <!-- HERO -->
    <section class="pt-16 md:pt-20 bg-warm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

          <!-- Text -->
          <div class="order-2 lg:order-1">
            <div class="inline-flex items-center gap-2 bg-primary/10 text-primary text-xs font-semibold tracking-wide px-3 py-1.5 rounded-full mb-6 uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              Sobre el médico
            </div>

            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-dark leading-[1.1] mb-4">
              Dr. José Alan<br />Polanco Fierro
            </h1>

            <p class="text-base font-semibold text-primary mb-2">
              Especialista en Medicina del Deporte · UNAM
            </p>
            <div class="flex flex-col gap-0.5 mb-6">
              <p class="text-xs text-muted">Médico Cirujano UNAM · Cédula Profesional 6382840</p>
              <p class="text-xs text-muted">Especialidad en Medicina del Deporte · Cédula Profesional 10861477</p>
            </div>

            <p class="text-base md:text-lg text-muted leading-relaxed mb-8 max-w-lg">
              Médico especialista en Medicina del Deporte, Director de QP Clinic y médico adscrito al Hospital General Dr. Rubén Leñero. Más de 10 años ayudando a personas a vivir mejor a través del movimiento.
            </p>

            <a
              href={WA}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold px-7 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Agenda tu consulta
            </a>
          </div>

          <!-- Photo -->
          <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
            <div class="relative w-full max-w-sm">
              <div class="absolute -inset-3 bg-primary/8 rounded-3xl rotate-3"></div>
              <div class="absolute -inset-3 bg-accent/6 rounded-3xl -rotate-1"></div>
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
                <img
                  src="/images/dr-polanco-sobremi.jpg"
                  alt="Dr. José Alan Polanco Fierro"
                  class="absolute inset-0 w-full h-full object-cover object-top"
                />
                <div class="absolute bottom-0 inset-x-0 bg-dark/75 backdrop-blur-sm px-5 py-4">
                  <p class="text-white text-sm font-semibold">Dr. José Alan Polanco Fierro</p>
                  <p class="text-white/65 text-xs mt-0.5">Especialista en Medicina del Deporte</p>
                </div>
              </div>
              <div class="absolute -bottom-4 -right-4 bg-white rounded-2xl shadow-2xl px-4 py-3 text-center">
                <p class="text-2xl font-display text-primary font-bold">+10</p>
                <p class="text-xs text-muted">años de experiencia</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- HISTORIA -->
    <section class="bg-surface py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center mb-14">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Mi historia</p>
          <h2 class="font-display text-3xl md:text-4xl text-dark leading-tight">
            Por qué elegí este camino
          </h2>
        </div>

        <!-- Imagen -->
        <div class="mb-12">
          <img src="/images/dr-polanco-pumas.jpg" alt="Dr. Alan Polanco en cancha" class="w-full rounded-2xl object-cover" style="min-height: 300px;" />
        </div>

        <div class="space-y-10">
          {historia.map(h => (
            <div class="flex gap-6">
              <div class="flex flex-col items-center shrink-0">
                <div class="w-3 h-3 rounded-full bg-primary mt-1.5 shrink-0"></div>
                <div class="w-0.5 bg-primary/20 flex-1 mt-2"></div>
              </div>
              <div class="pb-4">
                <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">{h.titulo}</p>
                {h.cita
                  ? <p class="font-display text-2xl md:text-3xl text-dark italic">"{h.texto}"</p>
                  : <p class="text-muted leading-relaxed text-base md:text-lg">{h.texto}</p>
                }
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- CREDENCIALES -->
    <section class="bg-warm py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center mb-12">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Formación y cargos</p>
          <h2 class="font-display text-3xl md:text-4xl text-dark leading-tight">
            Credenciales
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {credenciales.map(c => (
            <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-2xl px-4 py-4 shadow-sm">
              <div class="w-8 h-8 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-bold text-dark leading-snug">{c.inst}</p>
                <p class="text-xs text-muted mt-0.5 leading-snug">{c.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="bg-primary-dark py-16 md:py-24">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl md:text-4xl text-white mb-4">
          ¿Listo para dar el primer paso?
        </h2>
        <p class="text-white/70 text-base md:text-lg mb-8">
          Agenda tu consulta hoy y empieza a entender cómo funciona tu cuerpo.
        </p>
        <a
          href={WA}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-primary font-semibold px-8 py-4 rounded-xl transition-all duration-200 shadow-lg hover:-translate-y-0.5 text-base"
        >
          <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Agendar por WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
