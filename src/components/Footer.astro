---

<footer class="bg-dark text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-10 border-b border-white/10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center shrink-0">
            <span class="text-white text-sm font-display italic">AP</span>
          </div>
          <span class="font-display text-white text-sm">Dr. Alan Polanco</span>
        </div>
        <p class="text-white/50 text-xs leading-relaxed">
          La ciencia del movimiento,<br/>explicada para que puedas vivirla.
        </p>

        <!-- Social -->
        <div class="flex gap-3 mt-5">
          {redes.map(r => (
            <a
              href={r.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={r.label}
              class="w-16 h-16 rounded-lg bg-white/10 hover:bg-primary flex items-center justify-center transition-colors duration-200"
              set:html={r.icon}
            />
          ))}
        </div>
      </div>

      <!-- Nav -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Navegación</p>
        <ul class="flex flex-col gap-2.5">
          {nav.map(l => (
            <li>
              <a href={l.href} class="text-sm text-white/60 hover:text-white transition-colors duration-200">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Especialidades -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Especialidades</p>
        <ul class="flex flex-col gap-2.5">
          {especialidades.map(e => (
            <li>
              <a href="#especialidades" class="text-sm text-white/60 hover:text-white transition-colors duration-200">
                {e}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/40 mb-4">Contacto</p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-sm text-white/60">QP Clinic, CDMX</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:drjoepolanco@gmail.com" class="text-sm text-white/60 hover:text-white transition-colors break-all">
              drjoepolanco@gmail.com
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <a href="https://wa.me/525644237028?text=Hola%20Dr.%20Polanco%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta." target="_blank" rel="noopener noreferrer" class="text-sm text-white/60 hover:text-white transition-colors">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6">
      <p class="text-xs text-white/30">
        © {new Date().getFullYear()} Dr. José Alan Polanco Fierro. Todos los derechos reservados.
      </p>
      <p class="text-xs text-white/30">
        Cédula Profesional: <strong class="font-medium text-white/40">10861477</strong>
      </p>
    </div>

  </div>
</footer>
