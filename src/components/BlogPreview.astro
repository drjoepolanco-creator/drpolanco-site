---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categories: Record<string, string> = {
  'control-de-peso':      'Control de peso',
  'medicina-del-deporte': 'Medicina del Deporte',
  'prevencion':           'Prevención y Rehabilitación',
  'ciencia-aplicada':     'Ciencia Aplicada',
};
---

<section id="blog" class="bg-surface py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header row -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Artículos</p>
        <h2 class="font-display text-3xl md:text-4xl text-dark">Blog</h2>
      </div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:gap-3 transition-all duration-200"
      >
        Ver todos los artículos
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map(post => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="group bg-warm rounded-2xl overflow-hidden border border-gray-100 hover:border-primary/20 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">

            {post.data.image ? (
              <div class="aspect-video overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt ?? post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            ) : (
              <div class="aspect-video bg-gradient-to-br from-primary/12 to-accent/12 flex items-center justify-center">
                <svg class="w-10 h-10 text-primary/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            )}

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
                <span class="text-xs font-semibold text-primary bg-primary/10 px-2.5 py-1 rounded-full">
                  {categories[post.data.category] ?? post.data.category}
                </span>
                <span class="text-xs text-muted">
                  {post.data.pubDate.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' })}
                </span>
              </div>

              <h3 class="font-semibold text-dark text-sm leading-snug mb-3 group-hover:text-primary transition-colors line-clamp-2">
                {post.data.title}
              </h3>

              <p class="text-xs text-muted leading-relaxed flex-1 mb-5 line-clamp-3">
                {post.data.description}
              </p>

              <a
                href={`/blog/${slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:gap-2.5 transition-all duration-200 mt-auto"
              >
                Leer más
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
