// Datos estructurados del médico.
// Regla: solo se declara aquí lo que el visitante puede ver en la página.
// Cuando publiques dirección, teléfono y horarios en el footer,
// añade aquí "address", "telephone" y "openingHours".
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: 'Dr. José Alan Polanco Fierro',
  alternateName: 'Dr. Alan Polanco',
  url: 'https://www.dralanpolanco.com',
  image: 'https://www.dralanpolanco.com/images/dr-polanco-hero.jpg',
