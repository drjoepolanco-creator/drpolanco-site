    { '@type': 'CollegeOrUniversity', name: 'Instituto Politécnico Nacional' },
  ],
  sameAs: [
    'https://www.instagram.com/dralanpolanco/',
    'https://www.tiktok.com/@dralanpolanco',
    'https://www.facebook.com/profile.php?id=100078909799375',
