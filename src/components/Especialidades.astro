---
const items = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
    </svg>`,
    title: 'Control de peso y recomposición corporal',
    desc:  'Protocolos basados en ciencia para reducir grasa, ganar músculo y mantener el cambio a largo plazo.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>`,
    title: 'Medicina del deporte y rendimiento',
    desc:  'Optimización del rendimiento deportivo con evaluaciones funcionales y planes de entrenamiento médicamente supervisados.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
    </svg>`,
    title: 'Lesiones deportivas y rehabilitación',
    desc:  'Diagnóstico preciso y rehabilitación funcional para que regreses a tu actividad de manera segura y más fuerte.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
    </svg>`,
    title: 'Prescripción de ejercicio en enfermedades crónicas',
    desc:  'El ejercicio como medicina: planes específicos para diabetes, hipertensión, obesidad y otras enfermedades crónicas.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
    </svg>`,
    title: 'Evaluación médico-deportiva',
    desc:  'Valoración completa de aptitud física, composición corporal y capacidad funcional para deportistas y activos.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>`,
    title: 'Salud musculoesquelética y sarcopenia',
    desc:  'Prevención y tratamiento de la pérdida muscular asociada al sedentarismo, el envejecimiento y las enfermedades crónicas.',
  },
];
---

<section id="especialidades" class="bg-warm py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Lo que trato</p>
      <h2 class="font-display text-3xl md:text-4xl text-dark">Servicios</h2>
      <p class="mt-4 text-muted max-w-xl mx-auto text-sm md:text-base leading-relaxed">
        Un enfoque médico completo para que tu cuerpo funcione mejor — sin importar tu punto de partida.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map((item, i) => (
        <div class="group bg-surface rounded-2xl p-6 border border-gray-100 hover:border-primary/30 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-default">
          <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition-colors duration-300" set:html={item.icon} />
          <h3 class="font-semibold text-dark text-sm mb-2 leading-snug">{item.title}</h3>
          <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
