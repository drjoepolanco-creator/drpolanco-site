---
// Datos estructurados del artículo.
// Atribuye la entrada a la entidad Physician declarada en SchemaPhysician.astro,
// para que un buscador pueda resolver "quién escribió esto" sin ambigüedad.
// Regla: solo se declara lo que el visitante puede ver en la página.
import { PHYSICIAN_ID, SITE_URL } from '../lib/schema';
import { categoryLabel } from '../lib/categories';

interface Props {
  title:       string;
  description: string;
  pubDate:     Date;
  category:    string;
  image?:      string;
  url:         string;
}

const { title, description, pubDate, category, image, url } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: 'es-MX',
  articleSection: categoryLabel(category),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  ...(image ? { image: new URL(image, SITE_URL).href } : {}),
  author:    { '@id': PHYSICIAN_ID },
  publisher: { '@id': PHYSICIAN_ID },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
