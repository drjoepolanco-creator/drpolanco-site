---
const WA = "https://wa.me/5255644237028?text=Hola%20Dr.%20Polanco%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta.";

const badges = [
  'Certificado CoNaMeDe',
  'FIFA Diploma',
  'Profesor Escuela de Medicina St. Luke',
  'Director QP Clinic',
];
---

<section id="inicio" class="pt-16 md:pt-20 bg-warm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- TEXT -->
      <div class="order-2 lg:order-1">

        <!-- Eyebrow pill -->
        <div class="inline-flex items-center gap-2 bg-primary/10 text-primary text-xs font-semibold tracking-wide px-3 py-1.5 rounded-full mb-6 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          Medicina del Deporte · CDMX
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-dark leading-[1.1] mb-4">
          Dr. José Alan<br />Polanco Fierro
        </h1>

        <p class="text-base font-semibold text-primary mb-4">
          Especialista en Medicina del Deporte · UNAM
        </p>

        <p class="text-base md:text-lg text-muted leading-relaxed mb-8 max-w-lg">
          Ayudo a personas a entender cómo funciona su cuerpo y a usarlo a su favor&nbsp;— con ejercicio bien prescrito, ciencia aplicada y un plan realista para tu vida.
        </p>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 mb-10">
          <a
            href={WA}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold px-7 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-primary/25 hover:shadow-primary/40 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agenda tu consulta
          </a>
          <a
            href="#especialidades"
            class="inline-flex items-center justify-center gap-2 border-2 border-dark/20 hover:border-primary text-dark hover:text-primary font-semibold px-7 py-3.5 rounded-xl transition-all duration-200 hover:-translate-y-0.5"
          >
            Conoce mi trabajo
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
        </div>

        <!-- Credential badges -->
        <div class="flex flex-wrap gap-2">
          {badges.map(b => (
            <span class="inline-flex items-center gap-1.5 bg-white border border-gray-200 text-dark text-xs font-medium px-3 py-1.5 rounded-full shadow-sm">
              <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {b}
            </span>
          ))}
        </div>
      </div>

      <!-- PHOTO PLACEHOLDER -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm">
          <!-- Decorative rotated cards -->
          <div class="absolute -inset-3 bg-primary/8 rounded-3xl rotate-3"></div>
          <div class="absolute -inset-3 bg-accent/6  rounded-3xl -rotate-1"></div>

          <!-- Main card -->
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
            <img
              src="/images/dr-polanco-hero.jpg"
              alt="Dr. José Alan Polanco Fierro, especialista en Medicina del Deporte"
              class="absolute inset-0 w-full h-full object-cover object-center"
            />
            <!-- Bottom info bar -->
            <div class="absolute bottom-0 inset-x-0 bg-dark/75 backdrop-blur-sm px-5 py-4">
              <p class="text-white text-sm font-semibold">Dr. José Alan Polanco Fierro</p>
              <p class="text-white/65 text-xs mt-0.5">Especialista en Medicina del Deporte</p>
            </div>
          </div>

          <!-- Floating badge: pacientes -->
          <div class="absolute -left-7 top-1/4 bg-white rounded-2xl shadow-xl px-3 py-2.5 flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="text-xs font-bold text-dark">+500</p>
              <p class="text-xs text-muted">Pacientes</p>
            </div>
          </div>

          <!-- Floating badge: FIFA -->
          <div class="absolute -right-7 bottom-1/3 bg-white rounded-2xl shadow-xl px-3 py-2.5 flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-accent/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            </div>
            <div>
              <p class="text-xs font-bold text-dark">FIFA</p>
              <p class="text-xs text-muted">Diploma</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
