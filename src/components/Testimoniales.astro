---
const reviews = [
  {
    text:   "Soy deportista amateur desde hace más de 20 años, he visitado diferentes médicos deportivos y con certeza puedo decir que el Dr. Alan es el más actualizado, certero y dedicado a su trabajo.",
    author: "Víctor",
    via:    "Doctoralia",
    stars:  5,
  },
  {
    text:   "Excelente médico, muy empático y con amplios conocimientos. Me sentí escuchado y salí con un plan claro y realista.",
    author: "Paciente verificado",
    via:    "Doctoralia",
    stars:  5,
  },
  {
    text:   "Me explicó todo con detalle y paciencia, algo que no había encontrado antes. Se nota que le apasiona lo que hace y eso marca la diferencia.",
    author: "Paciente verificado",
    via:    "Doctoralia",
    stars:  5,
  },
];
---

<section class="bg-warm py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Testimonios</p>
      <h2 class="font-display text-3xl md:text-4xl text-dark">Lo que dicen mis pacientes</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map(r => (
        <div class="bg-surface rounded-2xl p-6 border border-gray-100 hover:shadow-lg transition-shadow duration-300 flex flex-col">

          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: r.stars }).map(() => (
              <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-sm text-dark leading-relaxed flex-1 mb-5">
            <span class="text-primary font-display text-2xl leading-none mr-1">"</span>{r.text}<span class="text-primary font-display text-2xl leading-none ml-1">"</span>
          </blockquote>

          <!-- Author -->
          <div class="flex items-center justify-between pt-4 border-t border-gray-100">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-primary/15 flex items-center justify-center">
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <span class="text-xs font-semibold text-dark">{r.author}</span>
            </div>
            <span class="text-xs text-muted bg-warm px-2 py-1 rounded-full">Vía {r.via}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
