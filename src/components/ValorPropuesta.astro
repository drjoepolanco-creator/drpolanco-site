---
const pillares = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
    </svg>`,
    title: 'Ciencia aplicada',
    desc:  'Cada plan está basado en evidencia científica y adaptado a tu cuerpo, tus objetivos y tu estilo de vida.',
    color: 'bg-primary/10 text-primary',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
    </svg>`,
    title: 'Visión integral',
    desc:  'Ejercicio, nutrición y salud van juntos. Mi enfoque considera al paciente en su totalidad, no solo el síntoma.',
    color: 'bg-accent/10 text-accent',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>`,
    title: 'Educación continua',
    desc:  'Te explico el porqué de cada decisión clínica. Un paciente que entiende su diagnóstico tiene mejores resultados.',
    color: 'bg-primary/10 text-primary',
  },
];
---

<section class="bg-surface py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Heading -->
    <div class="text-center mb-14">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Mi enfoque</p>
      <h2 class="font-display text-3xl md:text-4xl text-dark">Por qué mis pacientes<br class="hidden sm:block"/> obtienen resultados reales</h2>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {pillares.map(p => (
        <div class="group bg-warm rounded-2xl p-7 border border-gray-100 hover:border-primary/20 hover:shadow-lg transition-all duration-300">
          <div class={`w-12 h-12 rounded-xl ${p.color} flex items-center justify-center mb-5`} set:html={p.icon} />
          <h3 class="font-display text-xl text-dark mb-3">{p.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
