---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'Dr. Alan Polanco | Especialista en Medicina del Deporte',
  description = 'Médico especialista en Medicina del Deporte — UNAM, IPN, FIFA Diploma. Director QP Clinic. Consultas en CDMX.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-warm text-dark font-body antialiased">
    <slot />
  </body>
</html>
